# ════════════════════════════════════════════════════════════════
# DermaLens AI — Environment Variables Configuration
# ════════════════════════════════════════════════════════════════
#
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys and settings below
# 3. Keep .env private (do not commit to version control)
#
# ════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────
# REQUIRED VARIABLES
# ──────────────────────────────────────────────────────────────────

# Anthropic Claude API Key
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Where to get it:
#   1. Visit: https://console.anthropic.com/keys
#   2. Log in with your Anthropic account (or create one)
#   3. Copy your API key (looks like: sk-ant-...)
#   4. Paste below
#
# Without this key:
#   - CNN inference still works (image classification)
#   - ABCD analysis still works (rule-based)
#   - Clinical report generation will use fallback summaries
#
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────────
# OPTIONAL VARIABLES (leave blank or commented out to use defaults)
# ──────────────────────────────────────────────────────────────────

# Server Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PORT: Server port (default: 8000)
# Use a different port if 8000 is already in use on your system
# Example: PORT=8001, PORT=3000
#
# PORT=8000


# Logging Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LOG_LEVEL: Logging verbosity (default: info)
# Options: debug, info, warning, error, critical
#   - debug: Most verbose, includes all operations
#   - info: Standard level, shows important events
#   - warning: Only warnings and errors
#   - error: Only errors
#   - critical: Only critical failures
#
# Example: LOG_LEVEL=debug
#
# LOG_LEVEL=info


# Model Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MODEL_PATH: Path to trained model weights (default: models/dermalens_mobilenetv2.pth)
# By default, system looks for model in models/ folder
#
# MODEL_PATH=models/dermalens_mobilenetv2.pth


# Image Upload Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MAX_FILE_SIZE_MB: Maximum upload size in MB (default: 15)
# Recommended values: 5-50 MB
#
# MAX_FILE_SIZE_MB=15


# ──────────────────────────────────────────────────────────────────
# ADVANCED CONFIGURATION (for development/testing)
# ──────────────────────────────────────────────────────────────────

# Database Configuration (Future: for persistent user data)
# DATABASE_URL=sqlite:///./dermalens.db

# Authentication (Future: for multi-user system)
# SECRET_KEY=your-super-secret-key-change-in-production

# CORS Settings (for API access from specific domains)
# CORS_ORIGINS=http://localhost:3000,https://yourapp.com

# ──────────────────────────────────────────────────────────────────
# TROUBLESHOOTING
# ──────────────────────────────────────────────────────────────────
#
# "ModuleNotFoundError: No module named 'anthropic'"
#   → Run: pip install -r requirements.txt
#
# "ANTHROPIC_API_KEY not found"
#   → Check that .env file exists in project root
#   → Verify ANTHROPIC_API_KEY line is not commented out
#
# "Connection refused at localhost:8000"
#   → Server might not be running
#   → Run: uvicorn backend.main:app --reload
#
# "Port 8000 already in use"
#   → Change PORT in .env or stop the process using port 8000
#   → Or run: uvicorn backend.main:app --port 8001
#
# For more help, see: docs/TROUBLESHOOTING.md
#
# ════════════════════════════════════════════════════════════════

